# Test-mode env (committed, non-secret).
#
# The unit suite is pure-logic, but a couple of modules transitively construct
# the Supabase client at import time, which throws "supabaseUrl is required"
# when these are unset. Vite/Vitest load this file in test mode so the client
# constructs with harmless placeholders — no test actually hits the network.
# Real values come from .env.local for `dev`/`build`; this only applies to tests.
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key-not-used-in-tests
